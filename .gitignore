# Built by scripts/build_bundles.py. The GitHub Action builds and publishes
# it, so it isn't committed. (pathfinder.db IS committed: it's the source of
# truth for the trail data and its version numbers.)
# The leading / means only the public/ folder at the top of the repo, not
# other folders called public/ (like thack-main/public/, which holds the
# frontend's images and must be committed).
/public/

# Downloads saved by scripts/import_trails.py, so re-runs don't ask the free
# services (Lipas, Overpass) for the same data again
cache/

# Temporary file SQLite makes while it's writing
pathfinder.db-journal

# Python
__pycache__/
.venv/

# macOS
.DS_Store
