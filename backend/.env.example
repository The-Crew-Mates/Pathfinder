# Export these variables in your shell (or use Docker Compose).
# The app does not automatically read .env outside Docker Compose.
DB_PATH=./data/safety.sqlite3
DELIVERY_MODE=demo
RUN_WORKER=true
POLL_SECONDS=2
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated exact frontend origins; no wildcard.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional real email integration. Demo mode never sends email.
# DELIVERY_MODE=smtp
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=alerts@example.org
# SMTP_TLS=starttls
# SMTP_TIMEOUT=10

