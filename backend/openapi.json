  "components": {
    "schemas": {
      "CheckIn": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Event Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "progress",
              "returned"
            ],
            "title": "Kind"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          },
          "position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          },
          "recorded_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "kind"
        ],
        "title": "CheckIn"
      },
      "Consent": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 30,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Consent"
      },
      "ContactCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "title": "ContactCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "Position": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "landmark",
              "gps_untrusted"
            ],
            "title": "Source"
          },
          "accuracy_m": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy M"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "source"
        ],
        "title": "Position"
      },
      "Register": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "Register"
      },
      "ReturnTimeUpdate": {
        "properties": {
          "expected_return_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expected Return At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_return_at"
        ],
        "title": "ReturnTimeUpdate"
      },
      "Route": {
        "properties": {
          "type": {
            "type": "string",
            "const": "LineString",
            "title": "Type",
            "default": "LineString"
          },
          "coordinates": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 5000,
            "minItems": 2,
            "title": "Coordinates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "Route"
      },
      "TripCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "route": {
            "$ref": "#/components/schemas/Route"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "title": "Notes",
            "default": ""
          },
